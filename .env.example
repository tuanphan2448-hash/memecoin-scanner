# Optional but strongly recommended for on-chain wallet analysis.
ETHERSCAN_API_KEY=

# Optional. Enables recent-post search and social scoring.
X_BEARER_TOKEN=

# Optional Discord-compatible webhook for alerts.
ALERT_WEBHOOK_URL=

# Comma-separated DexScreener chain slugs.
CHAINS=ethereum,base,bsc,arbitrum,robinhood
MIN_LIQUIDITY_USD=25000
MAX_MARKET_CAP_USD=5000000
MAX_PAIR_AGE_MINUTES=1440
MIN_TOTAL_SCORE=55
POLL_SECONDS=60
DATABASE_PATH=scanner.db

